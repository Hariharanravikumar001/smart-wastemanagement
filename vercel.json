{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/smartwaste/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://smart-wastemanagement-backend.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets|favicon\\.ico|.*\\.js|.*\\.css|.*\\.png|.*\\.jpg|.*\\.svg|.*\\.ico|.*\\.woff|.*\\.woff2|.*\\.ttf|.*\\.eot|.*\\.map).*)",
      "destination": "/index.html"
    }
  ]
}
